{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false, "defaultGradients": false, "defaultPalette": false,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "contrast", "name": "Contrast", "color": "#17212b" },
        { "slug": "muted", "name": "Muted", "color": "#5d6872" },
        { "slug": "surface", "name": "Surface", "color": "#f3f6f7" },
        { "slug": "border", "name": "Border", "color": "#d5dde1" },
        { "slug": "accent", "name": "Accent", "color": "#087f73" },
        { "slug": "accent-dark", "name": "Accent Dark", "color": "#075e56" }
      ]
    },
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "spacing": {
      "blockGap": true,
      "spacingSizes": [
        { "slug": "20", "name": "2X Small", "size": "clamp(0.5rem, 0.45rem + 0.2vw, 0.625rem)" },
        { "slug": "30", "name": "X Small", "size": "clamp(0.75rem, 0.65rem + 0.35vw, 1rem)" },
        { "slug": "40", "name": "Small", "size": "clamp(1rem, 0.85rem + 0.55vw, 1.375rem)" },
        { "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 1.2rem + 1vw, 2.25rem)" },
        { "slug": "60", "name": "Large", "size": "clamp(2.25rem, 1.7rem + 1.8vw, 3.5rem)" },
        { "slug": "70", "name": "X Large", "size": "clamp(3.25rem, 2.3rem + 3vw, 5.5rem)" }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "dropCap": false, "fluid": true, "lineHeight": true,
      "fontFamilies": [
        { "slug": "sans", "name": "System Sans", "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic UI\", \"Yu Gothic\", Meiryo, sans-serif" },
        { "slug": "serif", "name": "System Serif", "fontFamily": "Georgia, \"Times New Roman\", \"Yu Mincho\", YuMincho, \"Hiragino Mincho ProN\", serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem)" },
        { "slug": "x-large", "name": "X Large", "size": "clamp(1.5rem, 1.25rem + 0.8vw, 2rem)" },
        { "slug": "xx-large", "name": "2X Large", "size": "clamp(2rem, 1.5rem + 1.8vw, 3.25rem)" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "spacing": { "blockGap": "var(--wp--preset--spacing--40)", "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "400", "lineHeight": "1.8" },
    "elements": {
      "button": { "border": { "radius": "0.25rem" }, "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base)" }, "typography": { "fontWeight": "600" } },
      "heading": { "typography": { "fontWeight": "650", "lineHeight": "1.35", "letterSpacing": "0" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent-dark)" } }
    },
    "blocks": { "core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" } } }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "Header" },
    { "area": "footer", "name": "footer", "title": "Footer" }
  ]
}
