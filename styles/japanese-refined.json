{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Japanese Refined",
  "settings": {
    "typography": {
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "ゴシック体 / Sans",
          "fontFamily": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic UI\", \"Yu Gothic\", Meiryo, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "serif",
          "name": "明朝体 / Serif",
          "fontFamily": "\"Yu Mincho\", YuMincho, \"Hiragino Mincho ProN\", \"Hiragino Mincho Pro\", Georgia, \"Times New Roman\", serif"
        }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.85"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "letterSpacing": "0",
          "lineHeight": "1.4"
        }
      },
      "h1": { "typography": { "fontSize": "clamp(1.85rem, 1.6rem + 0.8vw, 2.4rem)", "fontWeight": "650", "lineHeight": "1.35" } },
      "h2": { "typography": { "fontSize": "clamp(1.45rem, 1.3rem + 0.5vw, 1.8rem)", "lineHeight": "1.4" } },
      "h3": { "typography": { "fontSize": "clamp(1.2rem, 1.12rem + 0.25vw, 1.4rem)", "lineHeight": "1.5" } },
      "h4": { "typography": { "fontSize": "1.125rem" } },
      "h5": { "typography": { "fontSize": "1rem" } },
      "h6": { "typography": { "fontSize": "0.875rem" } }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.9"
        }
      },
      "core/list": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "400",
          "lineHeight": "1.85"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "letterSpacing": "0",
          "lineHeight": "1.6"
        }
      },
      "core/button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "letterSpacing": "0"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "400",
          "lineHeight": "1.8"
        }
      },
      "core/table": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "lineHeight": "1.75"
        }
      }
    }
  }
}
