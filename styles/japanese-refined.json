{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Japanese Refined",
  "settings": {
    "typography": {
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Japanese System Sans",
          "fontFamily": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic UI\", \"Yu Gothic\", Meiryo, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "serif",
          "name": "Japanese System Serif",
          "fontFamily": "\"Yu Mincho\", YuMincho, \"Hiragino Mincho ProN\", \"Hiragino Mincho Pro\", Georgia, \"Times New Roman\", serif"
        }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "clamp(1.15rem, 1rem + 0.4vw, 1.5rem)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "1rem",
      "fontWeight": "400",
      "lineHeight": "1.85"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "650",
          "letterSpacing": "0",
          "lineHeight": "1.45"
        }
      },
      "h1": { "typography": { "fontSize": "clamp(1.9rem, 1.6rem + 1vw, 2.6rem)" } },
      "h2": { "typography": { "fontSize": "clamp(1.55rem, 1.35rem + 0.65vw, 2rem)" } },
      "h3": { "typography": { "fontSize": "clamp(1.25rem, 1.15rem + 0.35vw, 1.5rem)" } },
      "h4": { "typography": { "fontSize": "1.125rem" } },
      "h5": { "typography": { "fontSize": "1rem" } },
      "h6": { "typography": { "fontSize": "0.875rem" } }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "500",
          "lineHeight": "1.9"
        }
      },
      "core/list": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "500",
          "lineHeight": "1.8"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "letterSpacing": "0",
          "lineHeight": "1.6"
        }
      },
      "core/button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "letterSpacing": "0"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "500",
          "lineHeight": "1.75"
        }
      },
      "core/table": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "lineHeight": "1.7"
        }
      }
    }
  }
}
